# Copy to .env and fill in real values.
# Local: keep REDIS_URL=redis://localhost:6379/0 and leave POSTGRES_* unset (uses SQLite).
# Docker/AWS: see DEPLOY_AWS.md — compose overrides REDIS_URL and POSTGRES_HOST.

DJANGO_SECRET_KEY="change-me-to-a-long-random-string"
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1,YOUR_EC2_PUBLIC_IP,your.domain.com"
CSRF_TRUSTED_ORIGINS="http://YOUR_EC2_PUBLIC_IP,https://your.domain.com"
CORS_ALLOWED_ORIGINS="http://YOUR_EC2_PUBLIC_IP,https://your.domain.com"

# Local only (Docker Compose sets redis://redis:6379/0 itself)
REDIS_URL="redis://localhost:6379/0"

# Postgres (used when POSTGRES_HOST is set — Docker sets this automatically)
POSTGRES_DB=lexora
POSTGRES_USER=lexora
POSTGRES_PASSWORD=change-me-strong-password

# Chat/search URL in the browser.
# Local without Docker: http://127.0.0.1:8001
# Docker/AWS with nginx: /ai
CHATBOT_API_BASE_URL="http://127.0.0.1:8001"

GROQ_API_KEY="your-groq-api-key"
COHERE_API_KEY="your-cohere-api-key"

EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_HOST_USER="your-email@gmail.com"
EMAIL_HOST_PASSWORD="your-gmail-app-password"
DEFAULT_FROM_EMAIL="your-email@gmail.com"

ANALYTICS_DIGEST_ENABLED=true
ANALYTICS_DIGEST_EMAIL="your-email@gmail.com"

# Pinecone (note exact key casing)
pinecone_Api_key="your-pinecone-api-key"
PINECONE_INDEX_NAME=documents
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
